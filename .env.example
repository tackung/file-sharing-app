# 両テナントで共通のFirebase Web設定（next build時に必要）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 以下の2項目は利用している場合に指定
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=

# サーバー実行時のみ。Cloud Runでは各サービスに個別に設定する
# FIREBASE_PROJECT_IDは上のNEXT_PUBLIC_FIREBASE_PROJECT_IDと同じID
FIREBASE_PROJECT_ID=
BUCKET_NAME=
# 両アプリの保存先。未設定時もhome/を使用する
STORAGE_ROOT_PREFIX=home/
ALLOWED_EMAILS=
# Cloud Runでは専用実行SAのADCを利用し、STORAGE_SA_KEYを省略する
# STORAGE_SA_KEY=/path/to/local-service-account.json
